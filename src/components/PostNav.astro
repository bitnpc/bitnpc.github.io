---
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { type Post, postPath } from '../utils/posts';

interface Props {
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { prev, next, locale } = Astro.props;
const t = useTranslations(locale);

// Chirpy semantics: "prev" = older post (left), "next" = newer post (right)
const prevLabel = t('post.previous');
const nextLabel = t('post.next');
---

<nav class="chirpy-post-nav mt-10" aria-label="Post navigation">
  {
    prev ? (
      <a href={postPath(prev)} rel="prev" class="chirpy-post-nav__btn" data-label={prevLabel}>
        <span class="chirpy-post-nav__title">{prev.data.title}</span>
      </a>
    ) : (
      <span class="chirpy-post-nav__btn is-disabled" data-label={prevLabel} aria-hidden="true" />
    )
  }

  {
    next ? (
      <a href={postPath(next)} rel="next" class="chirpy-post-nav__btn" data-label={nextLabel}>
        <span class="chirpy-post-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <span class="chirpy-post-nav__btn is-disabled" data-label={nextLabel} aria-hidden="true" />
    )
  }
</nav>
