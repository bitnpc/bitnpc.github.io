---
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  currentPage: number;
  lastPage: number;
  /** Function that returns the URL for a given page number. */
  // eslint-disable-next-line no-unused-vars
  hrefForPage: (page: number) => string;
  locale: Locale;
}

const { currentPage, lastPage, hrefForPage, locale } = Astro.props;
const t = useTranslations(locale);

if (lastPage <= 1) return null;

const prev = currentPage > 1 ? hrefForPage(currentPage - 1) : null;
const next = currentPage < lastPage ? hrefForPage(currentPage + 1) : null;

// Compact paginator: first, current-1, current, current+1, last (with ellipses).
const numbers: Array<number | '…'> = [];
const push = (n: number | '…') => {
  if (numbers[numbers.length - 1] !== n) numbers.push(n);
};
push(1);
if (currentPage - 1 > 2) push('…');
for (let p = Math.max(2, currentPage - 1); p <= Math.min(lastPage - 1, currentPage + 1); p++)
  push(p);
if (currentPage + 1 < lastPage - 1) push('…');
if (lastPage > 1) push(lastPage);
---

<nav
  aria-label={`${t('pagination.page')} ${currentPage} ${t('pagination.of')} ${lastPage}`}
  class="chirpy-pagination"
>
  {/* Previous arrow */}
  {
    prev ? (
      <a
        rel="prev"
        href={prev}
        class="chirpy-pagination__item"
        aria-label={t('pagination.previous')}
      >
        <Icon name="lucide:chevron-left" width={16} height={16} />
      </a>
    ) : (
      <button disabled class="chirpy-pagination__item" aria-label={t('pagination.previous')}>
        <Icon name="lucide:chevron-left" width={16} height={16} />
      </button>
    )
  }

  {/* Desktop: numbered pages */}
  {
    numbers.map((n) =>
      n === '…' ? (
        <span class="chirpy-pagination__ellipsis">…</span>
      ) : (
        <a
          href={hrefForPage(n)}
          aria-current={n === currentPage ? 'page' : undefined}
          class:list={['chirpy-pagination__item', n === currentPage && 'is-active']}
        >
          {n}
        </a>
      ),
    )
  }

  {/* Mobile: "1 / N" indicator */}
  <span class="chirpy-pagination__index">
    {currentPage} / {lastPage}
  </span>

  {/* Next arrow */}
  {
    next ? (
      <a rel="next" href={next} class="chirpy-pagination__item" aria-label={t('pagination.next')}>
        <Icon name="lucide:chevron-right" width={16} height={16} />
      </a>
    ) : (
      <button disabled class="chirpy-pagination__item" aria-label={t('pagination.next')}>
        <Icon name="lucide:chevron-right" width={16} height={16} />
      </button>
    )
  }
</nav>
